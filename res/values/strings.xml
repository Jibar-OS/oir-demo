    <!--
      v0.6.9: labels/descriptions for the three OIR signature
      permissions OirDemo declares. AOSP shows these in the settings
      "Special app access" screen when users inspect permissions a
      privileged app holds.
    -->
    <string name="perm_label_use_text">use on-device text AI</string>
    <string name="perm_desc_use_text">Allows the app to submit text
        generation, translation, embedding, classification, and rerank
        requests to the on-device AI runtime.</string>
    <string name="perm_label_use_audio">use on-device audio AI</string>
    <string name="perm_desc_use_audio">Allows the app to submit audio
        transcription, synthesis, and voice-activity requests to the
        on-device AI runtime.</string>
    <string name="perm_label_use_vision">use on-device vision AI</string>
    <string name="perm_desc_use_vision">Allows the app to submit image
        description, detection, OCR, and embedding requests to the
        on-device AI runtime.</string>
